enum WishlistStatus {
    ACTIVE
    ARCHIVED
    DELETED
}

enum WishlistVisibility {
    PRIVATE
    SHARED
    PUBLIC
}

type Wishlist {
    id:          ID!
    name:        String!
    description: String
    status:      WishlistStatus!
    visibility:  WishlistVisibility!
    isDefault:   Boolean!
    itemCount:   Int!
    items:       [WishlistItem!]!
    createdAt:   DateTime!
    updatedAt:   DateTime!
}

type WishlistItem {
    id:                 ID!
    wishlistId:         ID!
    productId:          ID!
    variantId:          ID
    notifyOnPriceDrop:  Boolean!
    notifyOnRestock:    Boolean!
    createdAt:          DateTime!
}

type WishlistPage {
    content:  [Wishlist!]!
    pageInfo: PageInfo!
}

extend type Query {
    myWishlists:                          [Wishlist!]!
    myWishlist(wishlistId: ID!):          Wishlist!
    myDefaultWishlist:                    Wishlist!
    isInWishlist(productId: ID!, variantId: ID): Boolean!
    sharedWishlist(token: String!):       Wishlist
}
