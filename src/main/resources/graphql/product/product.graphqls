# =============================================================================
# Product GraphQL Schema  —  queries only (mutations live in REST)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Types
# ─────────────────────────────────────────────────────────────────────────────

type Product {
    id: ID!
    productNumber: String!
    storeId: ID
    sellerId: ID
    name: String!
    slug: String!
    brand: String
    sku: String
    description: String
    productType: String!
    status: String!
    visibility: String!
    createdAt: String!
    updatedAt: String!
}

type ProductVariant {
    id: ID!
    productId: ID!
    sku: String!
    barcode: String
    variantName: String
    variantStatus: String!
    size: String
    color: String
    isActive: Boolean!
    createdAt: String!
    updatedAt: String!
}

type ProductPage {
    content: [Product!]!
    totalElements: Long!
    totalPages: Int!
    currentPage: Int!
    pageSize: Int!
    hasNextPage: Boolean!
}

# ─────────────────────────────────────────────────────────────────────────────
# Queries
# ─────────────────────────────────────────────────────────────────────────────

extend type Query {

    # Public
    product(id: ID!): Product
    productBySlug(slug: String!): Product
    products(page: Int, size: Int): ProductPage
    productsByStore(storeId: ID!, page: Int, size: Int): ProductPage
    productVariants(productId: ID!): [ProductVariant!]!

    # Seller (own)
    myProducts(storeId: ID!, page: Int, size: Int): ProductPage
}

# All mutations (create, update, publish, archive, suspend, restore, variant CRUD)
# are handled exclusively by REST:
#   POST   /v1/sellers/me/stores/{storeId}/products
#   PATCH  /v1/sellers/me/stores/{storeId}/products/{id}
#   POST   /v1/sellers/me/stores/{storeId}/products/{id}/publish
#   POST   /v1/sellers/me/stores/{storeId}/products/{id}/archive
#   DELETE /v1/sellers/me/stores/{storeId}/products/{id}
#   POST   /v1/admin/products/{id}/approve
#   POST   /v1/admin/products/{id}/reject
#   POST   /v1/admin/products/{id}/suspend
#   POST   /v1/admin/products/{id}/restore
