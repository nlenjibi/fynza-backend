# =============================================================================
# Review & Rating Management — GraphQL Schema
# Covers: reviews, votes, reports, seller responses, moderation, aggregates
# Convention: extend type Query = reads only; extend type Mutation = writes only
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Object types
# ─────────────────────────────────────────────────────────────────────────────

type Review {
    id: ID!
    customerId: ID!
    productId: ID
    variantId: ID
    storeId: ID
    sellerId: ID
    orderId: ID
    orderItemId: ID
    status: ReviewStatus!
    rating: Int!
    title: String
    body: String!
    verifiedPurchase: Boolean!
    helpfulCount: Int!
    notHelpfulCount: Int!
    media: [ReviewMedia!]!
    sellerResponse: SellerReviewResponse
    editedAt: DateTime
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

type ReviewMedia {
    id: ID!
    mediaReference: String!
    mediaType: ReviewMediaType!
    sortOrder: Int!
}

type SellerReviewResponse {
    id: ID!
    sellerId: ID!
    body: String!
    status: SellerResponseStatus!
    createdAt: DateTime!
    updatedAt: DateTime!
}

type ReviewSummary {
    targetId: ID!
    targetType: ReviewTargetType!
    reviewCount: Int!
    averageRating: Float!
    rating1Count: Int!
    rating2Count: Int!
    rating3Count: Int!
    rating4Count: Int!
    rating5Count: Int!
    verifiedCount: Int!
    verifiedPercentage: Float!
}

type ReviewEligibility {
    eligible: Boolean!
    reason: String
    existingReviewId: ID
    productEligible: Boolean!
    storeEligible: Boolean!
}

type ReviewVoteResult {
    reviewId: ID!
    voteType: ReviewVoteType
    helpfulCount: Int!
    notHelpfulCount: Int!
}

type ReviewReportResult {
    id: ID!
    reviewId: ID!
    reason: ReviewReportReason!
    status: ReviewReportStatus!
    createdAt: DateTime!
}

type ReviewPage {
    content: [Review!]!
    pageNumber: Int!
    pageSize: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
}

type ReviewReportPage {
    content: [ReviewReportResult!]!
    pageNumber: Int!
    pageSize: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
}

# ─────────────────────────────────────────────────────────────────────────────
# Enums
# ─────────────────────────────────────────────────────────────────────────────

enum ReviewStatus {
    DRAFT
    PENDING_MODERATION
    PUBLISHED
    REJECTED
    HIDDEN
    FLAGGED
    DELETED
}

enum ReviewTargetType {
    PRODUCT
    STORE
}

enum ReviewVoteType {
    HELPFUL
    NOT_HELPFUL
}

enum ReviewReportReason {
    SPAM
    ABUSE
    HARASSMENT
    HATE
    FRAUD
    FALSE_REVIEW
    OFF_TOPIC
    PERSONAL_INFORMATION
    ILLEGAL_CONTENT
    OTHER
}

enum ReviewReportStatus {
    OPEN
    UNDER_REVIEW
    RESOLVED
    DISMISSED
}

enum ReviewModerationAction {
    APPROVE
    REJECT
    HIDE
    RESTORE
    FLAG
    ESCALATE
}

enum ReviewMediaType {
    PHOTO
    VIDEO
}

enum SellerResponseStatus {
    ACTIVE
    HIDDEN
    DELETED
    PENDING_MODERATION
}

# ─────────────────────────────────────────────────────────────────────────────
# Input types
# ─────────────────────────────────────────────────────────────────────────────

input CreateReviewInput {
    productId: ID
    variantId: ID
    storeId: ID
    orderId: ID!
    orderItemId: ID!
    rating: Int!
    title: String
    body: String!
}

input UpdateReviewInput {
    rating: Int
    title: String
    body: String
}

input ReviewVoteInput {
    voteType: ReviewVoteType!
}

input ReviewReportInput {
    reason: ReviewReportReason!
    description: String
}

input SellerResponseInput {
    body: String!
}

input ModerateReviewInput {
    action: ReviewModerationAction!
    reasonCode: String
    notes: String
}

input ResolveReportInput {
    resolution: ReviewReportStatus!
    notes: String
}

# ─────────────────────────────────────────────────────────────────────────────
# Queries — reads only
# ─────────────────────────────────────────────────────────────────────────────

extend type Query {

    # ── Public / unauthenticated ─────────────────────────────────────────────
    review(id: ID!): Review

    productReviews(productId: ID!, status: ReviewStatus, pagination: PageInput): ReviewPage!

    storeReviews(storeId: ID!, status: ReviewStatus, pagination: PageInput): ReviewPage!

    productReviewSummary(productId: ID!): ReviewSummary!

    storeReviewSummary(storeId: ID!): ReviewSummary!

    # ── Authenticated ────────────────────────────────────────────────────────
    myReviews(pagination: PageInput): ReviewPage!

    reviewEligibility(orderId: ID!, orderItemId: ID!): ReviewEligibility!

    # ── Admin (ADMIN / MANAGER) ──────────────────────────────────────────────
    adminReviews(status: ReviewStatus, pagination: PageInput): ReviewPage!

    adminReviewReports(status: ReviewReportStatus, pagination: PageInput): ReviewReportPage!

    # ── Seller ───────────────────────────────────────────────────────────────
    sellerReviews(status: ReviewStatus, pagination: PageInput): ReviewPage!
}

# ─────────────────────────────────────────────────────────────────────────────
# Mutations — writes only
# ─────────────────────────────────────────────────────────────────────────────

extend type Mutation {

    # ── Customer review lifecycle ────────────────────────────────────────────
    createReview(input: CreateReviewInput!): Review!
    updateReview(id: ID!, input: UpdateReviewInput!): Review!
    deleteReview(id: ID!): Boolean!

    # ── Votes ────────────────────────────────────────────────────────────────
    voteOnReview(reviewId: ID!, input: ReviewVoteInput!): ReviewVoteResult!
    removeReviewVote(reviewId: ID!): Boolean!

    # ── Reports ──────────────────────────────────────────────────────────────
    reportReview(reviewId: ID!, input: ReviewReportInput!): ReviewReportResult!

    # ── Seller responses ─────────────────────────────────────────────────────
    respondToReview(reviewId: ID!, input: SellerResponseInput!): Review!
    updateReviewResponse(reviewId: ID!, input: SellerResponseInput!): Review!
    deleteReviewResponse(reviewId: ID!): Boolean!

    # ── Admin moderation ─────────────────────────────────────────────────────
    moderateReview(reviewId: ID!, input: ModerateReviewInput!): Review!
    hideReview(reviewId: ID!, reason: String): Review!
    restoreReview(reviewId: ID!): Review!
    resolveReviewReport(reportId: ID!, input: ResolveReportInput!): ReviewReportResult!
}
