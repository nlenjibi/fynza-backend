# =============================================================================
# Store GraphQL Schema
# Covers: Seller store profile, payment settings, shipping settings, notifications
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Types
# ─────────────────────────────────────────────────────────────────────────────

type SellerStore {
    id: ID!
    storeName: String!
    storeDescription: String
    storeWebsite: String
    storeLogo: String
    storeBanner: String
    email: String
    phone: String
    region: String
    city: String
    businessAddress: String
    workingHours: String
    facebookUrl: String
    instagramUrl: String
    twitterUrl: String
    rating: BigDecimal
    totalReviews: Int
    totalProducts: Int
    totalSales: Int
    totalRevenue: BigDecimal
    verificationStatus: String
    businessRegistration: String
    bankName: String
}

type SellerPaymentSettings {
    id: ID!
    bankName: String
    accountHolderName: String
    accountNumber: String
    branch: String
    payoutSchedule: String
    updatedAt: DateTime
}

type SellerShippingSettings {
    id: ID!
    returnPolicy: String
    shippingZones: [ShippingZone!]!
    updatedAt: DateTime
}

type ShippingZone {
    id: ID!
    zoneName: String!
    zoneDescription: String
    region: String
    deliveryMethod: DeliveryMethod!
    shippingCost: BigDecimal!
    freeShippingMin: BigDecimal
    estimatedDays: String
    isActive: Boolean
    updatedAt: DateTime
}

type SellerNotificationSettings {
    id: ID!
    newOrders: Boolean
    orderUpdates: Boolean
    customerMessages: Boolean
    stockAlerts: Boolean
    paymentUpdates: Boolean
    refundRequests: Boolean
    promotionalEmails: Boolean
    updatedAt: DateTime
}

# ─────────────────────────────────────────────────────────────────────────────
# Queries
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Store Management Types (STORE-06)
# ─────────────────────────────────────────────────────────────────────────────

type Store {
    id: ID!
    storeName: String!
    slug: String!
    description: String
    logoMediaId: String
    bannerMediaId: String
    status: StoreStatus!
    visibility: StoreVisibility!
    businessEmail: String
    businessPhone: String
    website: String
    createdAt: DateTime!
    updatedAt: DateTime!
    settings: StoreSettings
    policies: [StorePolicy!]!
}

type StoreSummary {
    id: ID!
    storeName: String!
    slug: String!
    logoMediaId: String
    status: StoreStatus!
    visibility: StoreVisibility!
    sellerDisplayName: String
    productCount: Int
    avgRating: Float
    reviewCount: Int
    orderCount: Int
    createdAt: DateTime!
}

type StoreSettings {
    id: ID!
    currency: String!
    timezone: String!
    language: String!
    orderNotifications: Boolean!
    customerNotifications: Boolean!
    updatedAt: DateTime!
}

type StorePolicy {
    id: ID!
    type: StorePolicyType!
    title: String!
    content: String!
    version: Int!
    status: StorePolicyStatus!
    effectiveFrom: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

type StoreStatusHistory {
    id: ID!
    previousStatus: StoreStatus
    newStatus: StoreStatus!
    reason: String
    expiresAt: DateTime
    createdAt: DateTime!
}

type StorePage {
    content: [StoreSummary!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    hasNextPage: Boolean!
}

enum StoreStatus {
    DRAFT
    PENDING_REVIEW
    ACTIVE
    PAUSED
    SUSPENDED
    CLOSED
    ARCHIVED
}

enum StoreVisibility {
    PUBLIC
    PRIVATE
    UNLISTED
}

enum StorePolicyType {
    RETURN
    REFUND
    SHIPPING
    CANCELLATION
    WARRANTY
}

enum StorePolicyStatus {
    DRAFT
    ACTIVE
    ARCHIVED
}

extend type Query {

    # ── Store (SELLER) ───────────────────────────────────────────────────
    sellerStore: SellerStore!

    # ── Settings (SELLER) ────────────────────────────────────────────────
    sellerPaymentSettings: SellerPaymentSettings!
    sellerShippingSettings: SellerShippingSettings!
    sellerShippingZones: [ShippingZone!]!
    sellerNotificationSettings: SellerNotificationSettings!

    # ── New Store Management (STORE-06) — read only ───────────────────────
    myStore: Store!
    storeBySlug(slug: String!): StoreSummary!
    stores(query: String, status: StoreStatus, visibility: StoreVisibility, page: Int, size: Int): StorePage!
    storeStatusHistory(storeId: ID!): [StoreStatusHistory!]!
}
