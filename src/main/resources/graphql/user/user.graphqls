# =============================================================================
# User GraphQL Schema
# Covers: me / profile queries, admin user management, customer dashboard
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Enums (local to this schema file; kept in sync with Java enums)
# ─────────────────────────────────────────────────────────────────────────────

enum Role {
    CUSTOMER
    SELLER
    ADMIN
    MODERATOR
}

enum UserStatus {
    PENDING_VERIFICATION
    ACTIVE
    SUSPENDED
    LOCKED
    DISABLED
    DELETED
}

enum AddressType {
    SHIPPING
    BILLING
    BOTH
}

# ─────────────────────────────────────────────────────────────────────────────
# Core Types
# ─────────────────────────────────────────────────────────────────────────────

type User {
    id: ID!
    email: String!
    username: String!
    firstName: String!
    lastName: String!
    fullName: String!
    displayName: String
    phone: String
    profileImageUrl: String
    role: Role!
    status: UserStatus!
    emailVerified: Boolean!
    isActive: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime!
    lastLoginAt: DateTime
}

type UserProfile {
    id: ID!
    email: String!
    username: String!
    firstName: String!
    lastName: String!
    displayName: String
    phone: String
    avatarUrl: String
    dateOfBirth: String
    language: String!
    timezone: String!
    currency: String!
    role: Role!
    status: UserStatus!
    emailVerified: Boolean!
    mfaEnabled: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime!
    deletionRequestedAt: DateTime
}

type UserPage {
    content: [UserProfile!]!
    pageInfo: PageInfo!
}

# ─────────────────────────────────────────────────────────────────────────────
# Address Types
# ─────────────────────────────────────────────────────────────────────────────

type Address {
    id: ID!
    label: String
    addressType: AddressType!
    streetAddress: String!
    city: String!
    state: String!
    postalCode: String!
    country: String!
    isDefault: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime!
}

# ─────────────────────────────────────────────────────────────────────────────
# Customer Dashboard Types
# ─────────────────────────────────────────────────────────────────────────────

type CustomerDashboard {
    totalOrders: Long!
    wishlistItems: Long!
    savedAddresses: Long!
    loyaltyPoints: Int!
    totalSpent: BigDecimal!
    membershipStatus: String!
    recentOrders: [CustomerRecentOrder!]!
}

type CustomerRecentOrder {
    orderId: String!
    orderNumber: String!
    orderDate: String!
    status: String!
    totalAmount: BigDecimal!
}

# ─────────────────────────────────────────────────────────────────────────────
# Loyalty Types
# ─────────────────────────────────────────────────────────────────────────────

type LoyaltyRedemption {
    previousPoints: Int!
    redeemedPoints: Int!
    remainingPoints: Int!
    discountAmount: BigDecimal!
    rewardType: String!
    couponCode: String
    message: String!
}

# ─────────────────────────────────────────────────────────────────────────────
# Inputs
# ─────────────────────────────────────────────────────────────────────────────

input UserFilterInput {
    search: String
    role: Role
    status: UserStatus
    active: Boolean
    emailVerified: Boolean
    createdAfter: DateTime
    createdBefore: DateTime
    phoneNumber: String
    name: String
}

# ─────────────────────────────────────────────────────────────────────────────
# Queries
# ─────────────────────────────────────────────────────────────────────────────

extend type Query {
    # ── Authenticated self-service ────────────────────────────────────────────
    me: UserProfile
    currentUser: User

    # ── Admin user queries (ADMIN only) ──────────────────────────────────────
    user(id: ID!): UserProfile
    users(pagination: PageInput, filter: UserFilterInput): UserPage!

    # ── Customer queries ──────────────────────────────────────────────────────
    customerDashboard: CustomerDashboard!
    myAddresses: [Address!]!
    loyaltyBalance: LoyaltyRedemption!
}
