
# =============================================================================
# Order GraphQL Schema
# All reads are here. Mutations are REST-only.
# POST /v1/checkout         — create order
# POST /v1/orders/{id}/cancel — cancel
# PATCH /v1/admin/orders/{id} — admin status update
# PATCH /v1/seller/orders/{id}/status — seller status update
# =============================================================================

type OrderAddress {
    fullName: String
    phone: String
    line1: String
    line2: String
    city: String
    state: String
    postalCode: String
    country: String
}

type OrderItem {
    id: ID!
    productId: ID!
    variantId: ID
    sellerId: String
    productName: String!
    productSku: String
    productImageUrl: String
    quantity: Int!
    unitPrice: BigDecimal!
    subtotal: BigDecimal!
    createdAt: DateTime
}

type Order {
    id: ID!
    orderNumber: String!
    status: String!
    paymentStatus: String!
    paymentMethod: String
    customerId: ID!
    items: [OrderItem!]!
    subtotal: BigDecimal!
    tax: BigDecimal!
    shippingCost: BigDecimal!
    discount: BigDecimal!
    totalAmount: BigDecimal!
    couponCode: String
    trackingNumber: String
    customerNotes: String
    shippingAddress: OrderAddress
    billingAddress: OrderAddress
    createdAt: DateTime!
    updatedAt: DateTime
}

type OrderPage {
    content: [Order!]!
    pageInfo: PageInfo
}

type OrderTimeline {
    id: ID!
    status: String!
    message: String
    changedBy: ID
    occurredAt: DateTime!
}

type OrderTracking {
    orderId: ID!
    orderNumber: String!
    status: String!
    displayName: String
    trackingNumber: String
    timeline: [OrderTimeline!]!
}

type OrderStats {
    totalOrders: Int!
    pendingOrders: Int!
    confirmedOrders: Int!
    processingOrders: Int!
    shippedOrders: Int!
    deliveredOrders: Int!
    cancelledOrders: Int!
    totalRevenue: BigDecimal!
    averageOrderValue: BigDecimal!
}

type RecentOrder {
    orderId: String!
    orderNumber: String!
    customerName: String
    amount: BigDecimal!
    status: String!
    createdAt: String!
}

type OrderDashboard {
    totalOrders: Int!
    pendingOrders: Int!
    recentOrders: [RecentOrder!]!
    totalRevenue: BigDecimal!
    orderCompletionRate: Float!
    cancellationRate: Float!
}

type SellerOrderStats {
    totalOrders: Int!
    pending: Int!
    confirmed: Int!
    processing: Int!
    shipped: Int!
    delivered: Int!
    cancelled: Int!
}

extend type Query {

    # ── Customer ──────────────────────────────────────────────────────────────
    order(id: ID!): Order
    orderByNumber(orderNumber: String!): Order
    myOrders(pagination: PageInput): OrderPage!

    # ── Tracking ──────────────────────────────────────────────────────────────
    orderTracking(orderId: ID!): OrderTracking!
    orderTimeline(orderId: ID!): [OrderTimeline!]!

    # ── Admin ─────────────────────────────────────────────────────────────────
    allOrders(pagination: PageInput): OrderPage!
    adminSearchOrders(query: String, status: String, paymentStatus: String, pagination: PageInput): OrderPage!
    ordersByStatus(status: String!, pagination: PageInput): OrderPage!
    orderStatistics: OrderStats!
    orderDashboard: OrderDashboard!
    customerOrders(customerId: ID!, pagination: PageInput): OrderPage!

    # ── Seller ────────────────────────────────────────────────────────────────
    sellerOrders(pagination: PageInput): OrderPage!
    sellerOrderStats: SellerOrderStats!
}
